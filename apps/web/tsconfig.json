{
  "extends": "@explorer/config/tsconfig",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "composite": false,
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
