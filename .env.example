# Local development defaults — connects the explorer to a locally-running
# Lineage node from ../fleet (`cd ../fleet && docker compose up`) and a local
# Postgres started with `pnpm dev:db`.
#
# Quick start:
#   1. cd ../fleet && docker compose up          # Lineage node cluster (ports 3001/3003)
#   2. pnpm dev:db                                # local Postgres on :5432
#   3. cp .env.example .env  (or: pnpm setup)
#   4. pnpm db:migrate                            # create the schema
#   5. pnpm dev                                   # indexer + web (hot reload)
#      web → http://localhost:8080

# Postgres (local, started by `pnpm dev:db`). Host is localhost for host-run dev.
DATABASE_URL=postgres://explorer:explorer@localhost:5432/explorer
POSTGRES_USER=explorer
POSTGRES_PASSWORD=explorer
POSTGRES_DB=explorer

# Lineage node — from ../fleet's docker compose (published to the host):
#   storage-node HTTP API :3001  → blocks (/latest_block, /block_by_num, /blockchain_entry)
#   mempool-node HTTP API :3003  → supply (/issued_supply, /total_supply)
# The mempool URL is required for circulating supply — supply endpoints live on
# the mempool node, not the storage node.
LINEAGE_STORAGE_NODE_URL=http://localhost:3001
LINEAGE_MEMPOOL_NODE_URL=http://localhost:3003
# Optional explicit overrides (default: derived as ${mempool||storage}/issued_supply etc.)
# LINEAGE_ISSUED_SUPPLY_URL=
# LINEAGE_TOTAL_SUPPLY_URL=

# Indexer
INDEXER_GENESIS_HEIGHT=0
INDEXER_MAX_BLOCK_RANGE=1000
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_TX_HTTP_BATCH=200
INDEXER_TX_HTTP_CONCURRENCY=4
INDEXER_TX_HTTP_INTER_BATCH_DELAY_MS=0
SUPPLY_CRON_INTERVAL_MS=300000
# Comma-separated tx hashes to skip. Note: g48e47a828b77e0d71273ba43ea1f4ef
# historically required skipping — add it here if ingestion errors on it.
INDEXER_SKIP_TX_HASHES=
INDEXER_LOCK_ON_BUSY=exit
HEALTH_PORT=8090
LOG_LEVEL=info

# Brand overrides (optional)
# TOKEN_TICKER=LNGX
# TOKEN_DISPLAY_NAME=Lineage
