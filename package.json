{
  "name": "explorer",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "cp -n .env.example .env || true",
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:db": "docker compose up -d postgres",
    "dev:stop": "docker compose stop postgres",
    "db:migrate": "dotenv -e .env -- pnpm --filter @explorer/db exec drizzle-kit migrate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "dev:docker": "docker compose -f docker-compose.dev.yml up"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2"
  }
}
